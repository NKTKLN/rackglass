# Runtime configuration for rackglass.
#
#   cp config.env.example config.env
#   cargo run
#
# Read when the app starts, not baked in at build time. The file is looked up
# in this order, first one found wins: the path in $RACKGLASS_CONFIG,
# ./config.env, /etc/rackglass/config.env. Any of these keys set in the
# environment overrides the file. config.env is gitignored, so your own
# endpoint and topology stay out of the repository.
#
# Anything left out here falls back to the default in src/config.rs.

# Base URL of the Prometheus server, no trailing slash.
PROM_URL=http://localhost:9090

# How often the instant queries are re-issued, in seconds. A target marks its
# snapshot stale after three missed polls, so this scales that with it.
POLL_SECONDS=5

# Interfaces kept out of the aggregate network totals, as a PromQL regex.
# The default excludes loopback and the usual Proxmox/Docker/libvirt virtual
# devices, so a forwarded packet is not counted once on the physical NIC, again
# on the bridge and again on the tap device.
NET_DEVICE_EXCLUDE=^(lo|veth.*|tap.*|fwbr.*|fwln.*|fwpr.*|vmbr.*|docker.*|br-.*|virbr.*)$

# The V4L2 node to capture from. A UVC stick exposes a capture node and a
# metadata node side by side and which index each gets is up to probe order, so
# the deployment names the right one instead of guessing. Leave empty to scan
# /dev/video* and step past nodes that turn out not to capture.
CAPTURE_DEVICE=/dev/video0

# Capture geometry requested from the V4L2 device. The card is flashed to offer
# 1024x600, matching the panel exactly; see the README for the measured rates.
CAPTURE_W=1024
CAPTURE_H=600
CAPTURE_FPS=30

# The node_exporter instance that is the hypervisor itself; every other target
# under job="node" is treated as a guest.
HYPERVISOR=pve-host

# Binary used to pull frames off the V4L2 device.
FFMPEG=ffmpeg
