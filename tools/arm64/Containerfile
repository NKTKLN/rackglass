# arm64 cross-build environment for rackglass, run natively on an x64 host.
#
# Rust cross-compiles cleanly, so unlike the Flutter build this replaced there
# is no emulation: an amd64 image carries the aarch64 toolchain plus the arm64
# dev packages of every native library the `kms` feature links, through
# Debian multiarch.
#
# Debian bookworm on purpose: it is what Raspberry Pi OS is based on, and
# building against its glibc (2.36) keeps the result runnable there.
FROM docker.io/library/debian:bookworm

ENV DEBIAN_FRONTEND=noninteractive
RUN dpkg --add-architecture arm64 \
    && apt-get update -qq && apt-get install -y -qq --no-install-recommends \
      ca-certificates curl pkg-config \
      gcc libc6-dev gcc-aarch64-linux-gnu libc6-dev-arm64-cross \
      libdrm-dev:arm64 libgbm-dev:arm64 libinput-dev:arm64 libseat-dev:arm64 \
      libudev-dev:arm64 libxkbcommon-dev:arm64 libfontconfig-dev:arm64 \
    && rm -rf /var/lib/apt/lists/*

RUN curl -sSf https://sh.rustup.rs \
      | sh -s -- -y --profile minimal --target aarch64-unknown-linux-gnu
ENV PATH="/root/.cargo/bin:${PATH}"

# Link with the cross gcc, and point pkg-config at the arm64 .pc files only:
# a host library found by mistake links fine and fails on the Pi.
ENV CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc \
    PKG_CONFIG_ALLOW_CROSS=1 \
    PKG_CONFIG_LIBDIR=/usr/lib/aarch64-linux-gnu/pkgconfig:/usr/share/pkgconfig \
    PKG_CONFIG_SYSROOT_DIR=/
